COMPOSE_PROJECT_NAME=crm-example-company
CRM_DOMAIN=crm.example.com
CRM_PUBLIC_URL=https://crm.example.com
CRM_HTTP_PORT=80
CRM_HTTPS_PORT=443

CRM_FRONTEND_IMAGE=registry.example.com/crm/frontend:0.1.0
CRM_BACKEND_IMAGE=registry.example.com/crm/backend:0.1.0
CADDY_IMAGE=caddy:2.11.4-alpine
POSTGRES_IMAGE=postgres:17.10-alpine

POSTGRES_DB=crm_platform
POSTGRES_USER=crm_platform
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
DATABASE_URL=postgresql+asyncpg://crm_platform:replace-with-the-same-random-hex-secret@database:5432/crm_platform

SESSION_COOKIE_NAME=crm_session
CSRF_COOKIE_NAME=crm_csrf
SESSION_IDLE_SECONDS=28800
INVITATION_LIFETIME_SECONDS=259200

EMAIL_BACKEND=disabled
EMAIL_FROM_ADDRESS=crm@example.com
EMAIL_FROM_NAME=CRM Platform
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

AI_PROVIDER=disabled
AI_MODEL=
AI_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
AI_TIMEOUT_SECONDS=45
AI_COOLDOWN_SECONDS=30
AI_CACHE_TTL_SECONDS=900
